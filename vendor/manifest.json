{
  "manifest_version": 3,
  "name": "Steam saver",
  "description": "Verify steam sites in real time.",
  "version": "1.0.1",
  "icons": {
    "128": "img/steam_saver.png"
  },
  "action": {
    "default_icon": "img/steam_saver.png"
  },
  "host_permissions": [
    "*://*/*"
  ],
  "permissions": [
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://steamcommunity.com/*/inventory/*",
        "https://steamcommunity.com/*/inventory"
      ],
      "css": [
        "css/steamInventory.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://steamcommunity.com/*/inventory/*",
        "https://steamcommunity.com/*/inventory"
      ],
      "js": [
        "js/content/inventoryPatch.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
